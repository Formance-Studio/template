# Application environment variables.
#
# Copy this file to `.env` and fill in the values. Do not commit `.env` —
# it contains credentials for your own database.

# PostgreSQL connection string for this application's own database.
# The gateway provisions a dedicated schema and role for every project; use
# those credentials here, never the gateway's administrative credentials.
DATABASE_URL=postgres://app_user:app_password@localhost:5432/app_database

# Secret used to sign session cookies. Generate a long random value:
#   bun -e 'console.log(crypto.randomUUID())'
SESSION_SECRET=change-me
